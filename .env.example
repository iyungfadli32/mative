# MaTive — Environment Variables
# ================================
# File ini HANYA berisi NAMA variabel + penjelasan. JANGAN isi nilai nyata di sini.
# Salin ke `.env.local` (tidak di-commit) dan isi dari dashboard Supabase / Vercel.
# Tanpa variabel ini, aplikasi tetap bisa di-build dan menampilkan halaman publik,
# tetapi auth + data Supabase menampilkan status "belum dikonfigurasi".
# Lihat docs/decisions/ADR-0004-auth-supabase.md.

# URL proyek Supabase (contoh bentuk: https://<project-ref>.supabase.co).
# Didapat dari: Supabase Dashboard → Project Settings → API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Kunci publishable Supabase (format baru sb_publishable_..., aman dipakai di
# browser; RLS yang menegakkan izin). Didapat dari: Supabase Dashboard →
# Project Settings → API → Publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Anon/public key Supabase format lama (JWT) — OPSIONAL, hanya sebagai fallback
# bila publishable key belum tersedia. Jangan isi keduanya bila tidak perlu.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key Supabase — RAHASIA, HANYA di server, JANGAN PERNAH ke browser/bundle/log.
# Dipakai HANYA oleh server action admin yang eksplisit (mis. pembuatan undangan).
# Didapat dari: Supabase Dashboard → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# URL publik aplikasi (untuk callback auth). Lokal: http://localhost:3000
NEXT_PUBLIC_APP_URL=

# Timezone default workspace (IANA). Keputusan #13: Asia/Jakarta.
# Bisa diubah per workspace tanpa migrasi (kolom workspaces.timezone).
NEXT_PUBLIC_DEFAULT_TIMEZONE=
